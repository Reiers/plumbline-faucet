# Plumbline mainnet preview: environment for the SECOND instance.
# Copy to /opt/plumbline-faucet-mainnet/.env (mode 600, owner faucet-mainnet).
# Every key is MAINNET_ prefixed so a calibration .env is never reused.
# See docs/mainnet-activation-runbook.md.

NETWORK=mainnet

# ─── Dispenser ────────────────────────────────────────────────────
# Dedicated mainnet key. Never the calibration FAUCET_PK (boot refuses).
MAINNET_FAUCET_PK=
# Dry run: simulate every send against mainnet, broadcast nothing.
# With no key set, MAINNET_DRY_RUN_ADDRESS is used as a watch-only
# dispenser (useful to stage the instance before the float is funded).
MAINNET_DRY_RUN=0
MAINNET_DRY_RUN_ADDRESS=

# ─── Network ──────────────────────────────────────────────────────
MAINNET_RPC_URL=https://api.node.glif.io/rpc/v1
# USDFC on Filecoin mainnet (FilOzone synapse-sdk, synapse-core/src/chains.ts)
MAINNET_USDFC_ADDRESS=0x80B98d3aa09ffff255c3ba4A241111Ff1262F045

# ─── Kill switch ──────────────────────────────────────────────────
# Ships ON (mainnet preview, not yet activated). Drips stay disabled
# until the operator funds the float at activation.
# To enable drips set MAINNET_KILL_SWITCH=0 and restart. Unset or empty
# also means ON.
MAINNET_KILL_SWITCH=1
# If this file exists, drips stop immediately without a restart.
MAINNET_KILL_FILE=/opt/plumbline-faucet-mainnet/MAINNET_KILL

# ─── Notice ───────────────────────────────────────────────────────
# Shown on the page, in api/info, api/status and in every paused or
# unfunded refusal.
MAINNET_STATUS_NOTE=Mainnet preview: not yet activated. Docs: https://github.com/Reiers/plumbline-faucet/blob/main/docs/mainnet-preview.md
# USDFC drips need at least this much FIL in the float for gas.
MAINNET_MIN_GAS_FIL=0.01

# ─── Captcha (required, no bypass) ────────────────────────────────
MAINNET_TURNSTILE_SITE_KEY=
MAINNET_TURNSTILE_SECRET=
# Expected Turnstile action. The mainnet page renders the widget with
# this action, so calibration tokens cannot be replayed here.
MAINNET_TURNSTILE_ACTION=mainnet-drip

# ─── Per-drip amounts ─────────────────────────────────────────────
MAINNET_USDFC_DRIP=5
MAINNET_FIL_DRIP=0.05

# ─── Per-recipient caps (rolling window) ──────────────────────────
MAINNET_ADDRESS_WINDOW_SEC=604800
MAINNET_ADDRESS_CAP_USDFC=5
MAINNET_ADDRESS_CAP_FIL=0.05

# ─── Per-IP and per-subnet caps (anonymous path, rolling window) ──
MAINNET_IP_WINDOW_SEC=604800
MAINNET_IP_CAP_USDFC=10
MAINNET_IP_CAP_FIL=0.1
MAINNET_SUBNET_CAP_USDFC=20
MAINNET_SUBNET_CAP_FIL=0.2

# ─── Global caps ──────────────────────────────────────────────────
# Rolling 24h
MAINNET_DAILY_CAP_USDFC=25
MAINNET_DAILY_CAP_FIL=0.25
# Calendar month, UTC. Hard stop.
MAINNET_MONTHLY_CAP_USDFC=100
MAINNET_MONTHLY_CAP_FIL=1

# ─── Float reserve ────────────────────────────────────────────────
# Drips are refused when (balance - in-flight) < floor + one drip:
#   preview_unfunded  nothing above the floor (includes a zero float)
#   faucet_dry        less than one drip above the floor, or no FIL for gas
MAINNET_RESERVE_FLOOR_USDFC=10
MAINNET_RESERVE_FLOOR_FIL=0.5
# Low-reserve warning fires below floor + one drip + headroom.
MAINNET_LOW_RESERVE_HEADROOM_USDFC=20
MAINNET_LOW_RESERVE_HEADROOM_FIL=0.2

# ─── Abuse detection (trip when observed value is MORE than N) ────
MAINNET_ABUSE_AUTOBLOCK=1
MAINNET_ABUSE_BLOCK_SEC=86400
MAINNET_ABUSE_IP_ATTEMPTS_PER_HOUR=20
MAINNET_ABUSE_IP_DISTINCT_ADDRESSES_PER_DAY=3
MAINNET_ABUSE_IP_CAPTCHA_FAILS_PER_HOUR=5
MAINNET_ABUSE_SUBNET_ATTEMPTS_PER_HOUR=60
MAINNET_ABUSE_SUBNET_DISTINCT_ADDRESSES_PER_DAY=8
MAINNET_ABUSE_ADDRESS_DISTINCT_IPS_PER_DAY=4

# ─── Monitoring / alerts ──────────────────────────────────────────
# JSON POST on alerts; body includes "text" so Slack/Discord-style
# incoming webhooks work as is. Leave empty to only log alerts.
MAINNET_ALERT_WEBHOOK_URL=
MAINNET_ALERT_REPEAT_SEC=3600
MAINNET_MONITOR_INTERVAL_SEC=60
MAINNET_BALANCE_CACHE_SEC=15

# ─── Bind / runtime ───────────────────────────────────────────────
MAINNET_PORT=8006
MAINNET_HOST=127.0.0.1
MAINNET_TRUST_PROXY=127.0.0.1,::1
MAINNET_DB=/opt/plumbline-faucet-mainnet/mainnet.sqlite
MAINNET_GLOBAL_RPM=60
MAINNET_MAX_QUEUE=3
MAINNET_RECEIPT_TIMEOUT_MS=60000
